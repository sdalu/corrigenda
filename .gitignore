# Build output. `extension/build` remakes it from committed sources in a
# second, and the landing page says "not built yet" rather than offering
# a download that is not there — so a checkout is never wrong, only
# unbuilt.
extension/dist/

# Bundled gems and anything a run wrote. `bundle install --path vendor`
# puts the gems here, and a development run points its store here; both
# are made, not authored.
vendor/
store/
.bundle/

# FreeBSD writes these where a program crashed; diff did, once.
*.core

# Generated by deploy/macro from corrigenda.yml, and rewritten by ./run
# at every start. Tracking it would mean tracking a copy of three
# fields from the config, which is the drift the generator exists to
# prevent.
deploy/macro-corrigenda.conf

# This deployment: its hosts, its directory server, its paths. Copy
# deploy/corrigenda-template.yml to make one.
deploy/corrigenda.yml

# Anything a test needs that names this deployment rather than the
# program: real hostnames, a real account. Loaded by test_helper.rb if
# it exists, absent from a checkout, and the suites pass without it --
# see test/tracked_files_test.rb, which is what keeps such things out
# of the tracked files in the first place.
test/local.rb
