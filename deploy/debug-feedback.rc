#!/bin/sh
#
# Install as /usr/local/etc/rc.d/debug_feedback (mode 0755), then
#   sysrc debug_feedback_enable=YES && service debug_feedback start
#
# PROVIDE: debug_feedback
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="debug_feedback"
rcvar="debug_feedback_enable"

load_rc_config $name

: ${debug_feedback_enable:="NO"}
: ${debug_feedback_user:="debugfeedback"}
: ${debug_feedback_dir:="/web/ops/DebugFeedback"}
: ${debug_feedback_rundir:="/var/run/debug-feedback"}

pidfile="${debug_feedback_rundir}/debug-feedback.pid"
command="/usr/sbin/daemon"
command_args="-f -P ${pidfile} -u ${debug_feedback_user} ${debug_feedback_dir}/deploy/debug-feedback-run"

start_precmd="debug_feedback_prestart"

debug_feedback_prestart()
{
    # Group www so Apache can reach the socket; 0750 so nothing else can.
    install -d -o "${debug_feedback_user}" -g www -m 0750 "${debug_feedback_rundir}"
}

run_rc_command "$1"
