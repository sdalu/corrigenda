#!/usr/bin/env ruby
# frozen_string_literal: true

# Writes macro-corrigenda.conf from corrigenda.yml.
#
# Three facts were written twice: the socket the service listens on, the
# path it is mounted under, and who is allowed to reach it. Apache
# cannot read YAML, so the file it includes is generated from the one
# that configures the service — otherwise they drift, and the failures
# they produce say nothing about why. A proxy pointed at the wrong
# socket answers 503 with the service running; an auth block that
# disagrees with the deployment either locks the staff out or lets the
# world in.
#
#   ./macro                    write the file
#   ./macro --check            say whether it is current, exit 1 if not
#   ./macro --stdout           print it instead of writing
#   ./macro --config PATH      read another config (with --stdout)
#
# The generated file is NOT committed: it is three fields of the config
# in Apache syntax, and a copy of a config is the drift this exists to
# prevent. ../run writes it at every start, so the file Apache includes
# always agrees with the service that is running.

require "pathname"
require "yaml"

HERE   = Pathname(__dir__)
TARGET = HERE / "macro-corrigenda.conf"

config = HERE / "corrigenda.yml"
if (i = ARGV.index("--config"))
    config = Pathname(ARGV.fetch(i + 1) { abort "macro: --config needs a path" })
end

unless config.exist?
    abort <<~SAY
macro: #{config} does not exist.

    cp deploy/corrigenda-template.yml deploy/corrigenda.yml
    $EDITOR deploy/corrigenda.yml

Copying is not enough: the endpoint, the sites and the directory
server in the template are examples. That file names this
deployment, which is why it is not in the repository and why
nothing here can guess it.
    SAY
end

values = YAML.safe_load_file(config)
socket = values.fetch("socket")

# The mount is the path the endpoint answers on, which is the path
# component of its public URL. Everything Apache needs to know about
# where this lives is in that one value.
endpoint = values["endpoint"] or
    abort "macro: #{config} names no endpoint, so there is no mount to write"

mount = endpoint.sub(%r{\Ahttps?://[^/]+}, "").sub(%r{/+\z}, "")
abort "macro: #{endpoint} has no path to mount under" if mount.empty?

# Absent rather than "none": an endpoint that stores what staff report
# about the estate should not become world-writable because a key was
# forgotten. Saying `type: none` is allowed; saying nothing is not.
auth = values["auth"] or abort <<~SAY
    macro: #{config} has no auth block.

    Reports would then be accepted from anyone who can reach the vhost.
    If that is what you want, say so:

        auth:
            type: none

    Otherwise name a provider — ldap or file. See the block in
    deploy/corrigenda.yml.
SAY

realm    = auth.fetch("realm", "Corrigenda")
required = auth.fetch("require", "valid-user")

# Everything but OPTIONS, whatever the provider: a CORS preflight is
# sent with no credentials and no way to add any, so demanding them
# turns every cross-origin report into a 401 the page never sees the
# cause of. With no Require in force for OPTIONS, 2.4 asks for nothing.
def gated(directives, required)
    <<~APACHE.chomp
        #{directives}

            <LimitExcept OPTIONS>
                Require         #{required}
            </LimitExcept>
    APACHE
end

body =
    case auth["type"]
    when "ldap"
        url = auth["url"] or abort "macro: auth type ldap needs a url"
        gated(<<~APACHE.chomp, required)
            AuthName            "#{realm}"
                AuthType            basic
                AuthBasicProvider   ldap
                AuthLDAPURL         #{url}
        APACHE
    when "file"
        file = auth["file"] or abort "macro: auth type file needs a file"
        gated(<<~APACHE.chomp, required)
            AuthName            "#{realm}"
                AuthType            basic
                AuthBasicProvider   file
                AuthUserFile        #{file}
        APACHE
    when "none"
        <<~APACHE.chomp
            # No authentication: this deployment says so in its config.
                # Anyone who can reach the vhost can post a report and read
                # every report already filed.
                AuthType None
                Require all granted
        APACHE
    else
        abort "macro: unknown auth type #{auth['type'].inspect} " \
              "(ldap, file, none)"
    end

conf = <<~APACHE
    # -*- apache -*-
    #
    # Corrigenda endpoint. GENERATED by deploy/macro from #{config.basename} —
    # edit that, or the generator, and run ./macro again. The socket, the
    # mount and the authentication below are the ones the service itself
    # is configured with, which is the point: a proxy pointed at the wrong
    # socket answers 503 and says nothing about why.
    #
    # Install into Includes/ as macro-corrigenda.conf.proposed first:
    # httpd.conf includes Includes/*.conf, so the suffix parks the file
    # where it can be read and checked without being loaded.

    <Macro CorrigendaAuth>
        #{body}
    </Macro>

    # Auth lives INSIDE this macro on purpose: a vhost opts in with one
    # `Use CorrigendaEndpoint` and cannot mount the endpoint
    # unauthenticated by forgetting a second line.
    <Macro CorrigendaEndpoint>
        <Location #{mount}>
            Use CorrigendaAuth

            # REMOTE_USER is a server variable, not a header, so it does
            # not cross a proxy hop. `set` (not `add`) overwrites whatever
            # the client sent, which is what makes it trustworthy on the
            # far side.
            RequestHeader set X-Remote-User "expr=%{REMOTE_USER}"

            # This Location is stripped before proxying, so the app cannot
            # know the path it is served under; without this every link in
            # the review UI points one level too high.
            RequestHeader set X-Forwarded-Prefix "#{mount}"

            # Unix socket, as the other proxied vhosts here already do.
            # /var/run rather than their /tmp: /tmp is
            # world-writable, and a socket there can be raced by any local
            # user before the service binds it.
            ProxyPass        unix:#{socket}|http://127.0.0.1/
            ProxyPassReverse unix:#{socket}|http://127.0.0.1/
        </Location>

        # The widget itself, and only the widget. Every page that injects
        # it fetches it -- visitors included, who have no account and no
        # reason to be asked for one -- so this one path is public. What
        # is staff-only is the endpoint that RECEIVES reports and the
        # pages that read them, and those stay behind the Location above.
        #
        # After it, not before: a longer Location wins, and merging is in
        # order of appearance.
        <Location #{mount}/corrigenda.js>
            AuthType None
            Require all granted

            # A vhost that sets `ExpiresByType application/javascript` for
            # its own scripts appends a second max-age to this one, and a
            # header reading "max-age=300, max-age=604800" is a header no
            # two caches need agree on. mod_expires is turned off for this
            # one URL so the service's own answer is the only answer.
            ExpiresActive Off
        </Location>
    </Macro>
APACHE

if ARGV.include?("--stdout")
    print conf
    exit 0
end

if ARGV.include?("--check")
    current = TARGET.exist? ? TARGET.read : ""
    if current == conf
        puts "macro-corrigenda.conf is current"
        exit 0
    end

    warn "macro-corrigenda.conf does not match #{config.basename}; run deploy/macro"
    exit 1
end

TARGET.write(conf)
puts "wrote #{TARGET.basename} (mount #{mount}, socket #{socket}, " \
     "auth #{auth['type']})"
