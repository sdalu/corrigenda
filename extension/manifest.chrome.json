{
  "manifest_version": 3,
  "name": "Corrigenda capture",
  "version": "0.1.0",
  "description": "Gives the corrigenda widget a screenshot the browser can crop: the tab itself, in page coordinates, with no share dialog.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Report a page defect",
    "default_icon": "icon-48.png"
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "minimum_chrome_version": "102"
}
