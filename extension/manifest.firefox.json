{
  "manifest_version": 3,
  "name": "Corrigenda capture",
  "version": "0.1.0",
  "description": "Gives the corrigenda widget a screenshot the browser can crop: the tab itself, in page coordinates, with no share dialog.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.alux.fr/*",
    "https://www.sdalu.com/*",
    "https://tools.sdalu.com/*",
    "https://kuiristo.eu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.alux.fr/*",
        "https://www.sdalu.com/*",
        "https://tools.sdalu.com/*",
        "https://kuiristo.eu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "corrigenda@sdalu.com",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_title": "Report a page defect",
    "default_icon": "icon.svg"
  }
}
