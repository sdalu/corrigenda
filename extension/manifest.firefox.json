{
  "manifest_version": 3,
  "name": "Corrigenda capture",
  "version": "0.2.0",
  "description": "Gives the corrigenda widget a screenshot the browser can crop: the tab itself, in page coordinates, with no share dialog.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{b57c993b-0234-443d-b987-f35365c59007}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_title": "Corrigenda: allow capture help here",
    "default_icon": "icon.svg"
  },
  "optional_host_permissions": [
    "*://*/*"
  ]
}
