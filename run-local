#!/bin/sh
#
# Run the endpoint straight out of the working copy: no service account,
# nothing under /usr/local/etc, no Apache, nothing to uninstall.
# deploy/ is the real installation; this is for trying things.
#
# Defaults come from deploy/debug-feedback.yml — the same file the
# installed service uses — and flags override them.

set -e

usage() {
    cat <<'EOF'
usage: run-local [-c CONFIG] [-p PORT | -s SOCKET] [-d STORE] [-f] [-h]

  -c CONFIG  defaults and endpoint config (default deploy/debug-feedback.yml)
  -p PORT    listen on 127.0.0.1:PORT
  -s SOCKET  listen on a unix socket instead, as the deployed service does
  -d STORE   where reports are written
  -f         also serve the test fixture page and the client
  -h         this text

Anything not given falls back to CONFIG, then to the built-in defaults
(port 9393, store ./store, no fixture).

CONFIG defaults to the file the installed service uses, so its store is
the real one: pass -d unless you mean to write there. -f additionally
drops the `sites` allowlist for the run, because the fixture page reports
itself as fixture.test and would otherwise be refused.

With -f, open the fixture URL printed at startup and drive the widget for
real -- including the screenshot channel, which asks for the genuine
screen-capture permission rather than the stub the browser test injects.
EOF
}

conf=""
port=""
socket=""
store=""
fixture=""

while getopts "c:p:s:d:fh" opt; do
    case "$opt" in
        c) conf="$OPTARG"   ;;
        p) port="$OPTARG"   ;;
        s) socket="$OPTARG" ;;
        d) store="$OPTARG"  ;;
        f) fixture=1 ;;
        h) usage ; exit 0 ;;
        *) usage >&2 ; exit 2 ;;
    esac
done

cd "$(dirname "$0")"

: "${conf:=deploy/debug-feedback.yml}"

if ! bundle check >/dev/null 2>&1; then
    echo "run-local: gems are not installed -- run: bundle install" >&2
    exit 1
fi

# Read the file with ruby, not with sed: it is YAML, and ruby is also the
# only reader here that sees the real filesystem rather than a
# /compat/linux shadow of it.
eval "$(ruby -ryaml -rshellwords -e '
    file = ARGV[0]
    values = File.exist?(file) ? (YAML.safe_load_file(file) || {}) : {}
    %w[port socket store fixture].each do |key|
        value = values[key]
        next if value.nil?
        puts "cfg_#{key}=#{Shellwords.escape(value.to_s)}"
    end' "$conf")"

port="${port:-${cfg_port:-9393}}"
socket="${socket:-${cfg_socket:-}}"
store="${store:-${cfg_store:-store}}"

case "${fixture:-$cfg_fixture}" in
    1|true|yes|on) rackup="test/browser/config.ru" ; fixture=1  ;;
    *)             rackup="config.ru"              ; fixture="" ;;
esac

# Create the store with ruby for the shadow reason above, and pass its
# location by environment so the config file stays the one you edited
# rather than one this script rewrites behind your back.
ruby -e 'require "fileutils" ; FileUtils.mkdir_p(ARGV[0])' "$store"
DEBUG_FEEDBACK_CONFIG="$conf"
DEBUG_FEEDBACK_STORE="$store"
export DEBUG_FEEDBACK_CONFIG DEBUG_FEEDBACK_STORE

# The fixture reports itself as fixture.test, which a production
# allowlist does not contain. Empty means "no allowlist" rather than
# "unset", so this only relaxes the run that asked for the fixture.
if [ -n "$fixture" ]; then
    DEBUG_FEEDBACK_SITES=""
    export DEBUG_FEEDBACK_SITES
fi

if [ -n "$socket" ]; then
    bind="unix://${socket}?umask=0117"
    echo "listening  ${socket}"
    echo "review     curl --unix-socket ${socket} http://localhost/review/"
else
    bind="tcp://127.0.0.1:${port}"
    echo "listening  127.0.0.1:${port}"
    [ -n "$fixture" ] && echo "fixture    http://127.0.0.1:${port}/fixture.html"
    echo "review     http://127.0.0.1:${port}/review/"
fi

echo "config     ${conf}"
echo "store      ${store}"
echo

exec bundle exec puma -b "$bind" "$rackup"
