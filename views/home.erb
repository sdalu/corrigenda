<% @wide = true %>
<h1>Report what a page got wrong</h1>

<p class="lede">
    Point at the problem on the page itself. What arrives here is the
    evidence rather than a description of it: the element, the rules
    that styled it, what the browser was complaining about, and a
    screenshot if you want one.
</p>

<figure class="specimen">
    <figcaption>Every visual report carries this</figcaption>
    <ol class="cascade">
        <li class="is-layer">@layer components</li>
        <li class="is-condition">@media (width &gt; 20rem)</li>
        <li class="is-selector">.caption
            <span class="where">/common/style/exhibition-standard.css</span>
        </li>
    </ol>
</figure>

<h2>Take it with you</h2>

<p>
    Drag this to your bookmarks toolbar, or right-click it and choose
    <em>Bookmark link</em>.
</p>

<p class="caveat is-warning">
    Pasting a <code>javascript:</code> URL into the address bar will not
    work — every browser strips it. It has to become a bookmark.
</p>

<div class="take">
    <p><a class="bookmarklet" href="#">Corrigenda</a></p>

    <div class="source">
        <div class="block">
            <pre class="bookmarklet-source"></pre>
            <button type="button" class="a-copy">Copy</button>
        </div>
    </div>
</div>

<h2 id="add-on">Or install the add-on</h2>

<p>
    The add-on is about the screenshot. A page can only photograph
    itself through the browser's screen-sharing permission: a prompt to
    answer, a surface to pick, and — in Firefox, which offers no tab —
    a frame that cannot be placed on the page at all, so no cropping to
    the element and no blacking out of form fields. The add-on takes
    the picture through the browser's own capture API instead.
</p>

<p>
    Its toolbar button also puts the widget on any page of the estate,
    which the bookmarklet does too. That is a convenience, not the
    reason: the add-on is worth having on a site that already serves
    Corrigenda itself, because the screenshot gets better either way.
</p>

<%
    # Three of the four capabilities are identical in both browsers, so
    # they are said once, above. What is left in each box is the line
    # that differs and the procedure — which is all anyone is here to
    # compare.
    browsers = [
        { key: "firefox", name: "Firefox",
          differs: [true, "Reaches below the fold — “no crop” is the page"],
          steps: ["<code>about:debugging</code> → This Firefox",
                  "Load Temporary Add-on → the unzipped " \
                  "<code>manifest.json</code>"],
          signed_steps: ["Open it, or click the link again and accept"] },

        { key: "chrome", name: "Chrome",
          differs: [false, "Visible page only — Chrome has no API for the rest"],
          steps: ["<code>chrome://extensions</code> → Developer mode",
                  "Load unpacked → the unzipped folder"] }
    ]
%>

<ul class="can is-shared">
    <li class="is-yes">No screen-share prompt to answer</li>
    <li class="is-yes">Crops to the element you picked</li>
    <li class="is-yes">Blacks out form fields before upload</li>
</ul>

<dl class="packages">
    <% browsers.each do |browser| %>
        <% package = packages[browser[:key]] %>
        <div>
            <dt><%= browser[:name] %></dt>

            <% if package %>
                <p class="get">
                    <a class="package" href="<%= mount("/extension/#{browser[:key]}") %>"
                       <%= "download" unless package[:signed] %>><svg
                       viewBox="0 0 448 512" aria-hidden="true"><path
                       d="M256 32c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 210.7-41.4-41.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l96 96c12.5 12.5 32.8 12.5 45.3 0l96-96c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 242.7 256 32zM64 320c-35.3 0-64 28.7-64 64l0 32c0 35.3 28.7 64 64 64l320 0c35.3 0 64-28.7 64-64l0-32c0-35.3-28.7-64-64-64l-46.9 0-56.6 56.6c-31.2 31.2-81.9 31.2-113.1 0L110.9 320 64 320zm304 56a24 24 0 1 1 0 48 24 24 0 1 1 0-48z"/></svg><%=
                       package[:signed] ? "Install" : "Download" %></a>
                    <span class="weight">Size: <%= (package[:bytes] / 1024.0).round %> kB<%=
                        ", signed" if package[:signed] %></span>
                </p>
            <% end %>

            <dd>
                <ul class="can">
                    <li class="<%= browser[:differs].first ? "is-yes" : "is-no" %>"><%=
                        browser[:differs].last %></li>
                </ul>

                <% if package %>
                    <ol class="steps">
                        <% (package[:signed] ? browser[:signed_steps] : browser[:steps]).each do |step| %>
                            <li><%== step %></li>
                        <% end %>
                    </ol>

                <% end %>
            </dd>

            <% if package %>
                    <% if browser[:key] == "firefox" && !package[:signed] %>
                        <p class="caveat is-warning">
                            This session only — Firefox drops a temporary
                            add-on when it restarts. A signed build installs
                            for good from the same link —
                            <a href="<%= mount("/signing") %>">how to make one</a>.
                        </p>
                    <% elsif browser[:key] == "chrome" %>
                        <p class="caveat is-warning">
                            Chrome installs extensions from its Web Store
                            only, so there is no self-hosted one-click
                            install to offer.
                        </p>
                    <% end %>
            <% else %>
                <p class="caveat">
                    Not built yet. Run
                    <code>extension/build <%= browser[:key] %></code>
                    where this service lives.
                </p>
            <% end %>
        </div>
    <% end %>
</dl>

<h2>Four kinds of report</h2>

<p>
    The kind sets what gets collected and how you point at the problem.
    The marks are what it switches on for you; every one of them is
    still yours to change before sending.
</p>

<%
    # The defaults the widget applies, in the same order and the same
    # letters it shows on its own menu — WANTED in the client.
    kinds = [
        ["Visual", "how it looks",
         %w[fragment rules computed diagnostics audit screenshot],
         "The element, the rules that matched it and the layer or media " \
         "query they came from, computed styles, geometry, the " \
         "accessibility check, and the screenshot control. For overlap, " \
         "spacing, colour, a layout that breaks at a width."],

        ["Content", "the words are wrong",
         %w[fragment],
         "Wording, typos, a stale fact. <strong>Select the text " \
         "first</strong> and the picker is skipped: the words are quoted " \
         "into the message and the elements holding them are recorded. " \
         "The element and nothing else — computed styles say nothing " \
         "about a spelling mistake."],

        ["Broken", "it does not work",
         %w[fragment diagnostics],
         "Behaviour rather than appearance: a control that does nothing, " \
         "an image that never arrives, a script that threw. Adds the " \
         "JavaScript errors and failed loads collected since the page " \
         "opened, and whether it overflows sideways."],

        ["Idea", "suggestion or question",
         [],
         "No element, no picker, no capture. The message and the page " \
         "you were on."]
    ]
%>

<dl class="kinds">
    <% kinds.each do |name, purpose, channels, what| %>
        <div>
            <dt><%= name %><span class="purpose"><%= purpose %></span></dt>
            <dd>
                <p class="marks">
                    <% if channels.empty? %>
                        <span class="empty">nothing but the message</span>
                    <% else %>
                        <% channels.each do |key| %>
                            <span class="chip" data-channel="<%= key %>"
                                  title="<%= Corrigenda::CHANNELS[key][1] %>"><%=
                                  Corrigenda::CHANNELS[key][0] %></span>
                        <% end %>
                    <% end %>
                </p>
                <p><%== what %></p>
            </dd>
        </div>
    <% end %>
</dl>

<%# The same legend the reports list carries, and the same letters the
    widget puts on its own menu: six marks learned once. %>
<dl class="legend">
    <% Corrigenda::CHANNELS.each do |key, (mark, label)| %>
        <dt><span class="chip" data-channel="<%= key %>"><%= mark %></span></dt>
        <dd><%= label %></dd>
    <% end %>
</dl>

<h2>Driving it</h2>

<dl class="kinds is-three">
    <div>
        <dt>Picking<span class="purpose">point at the problem</span></dt>
        <dd>
            <%# The same three hues the picker outlines the page with,
                and the same ones on its own help bar: a key is dressed
                as the box it will draw, so the colour is read rather
                than remembered. %>
            <p class="marks">
                <kbd class="k-parent">↑</kbd> parent
                <kbd class="k-child">↓</kbd> child
                <kbd class="k-sibling">←</kbd>
                <kbd class="k-sibling">→</kbd> siblings
            </p>
            <p>
                Click the element; the arrow keys walk the tree from
                there, because what you want is usually the container
                and not the leaf the mouse can reach.
                <kbd>Enter</kbd> locks it, <kbd>Esc</kbd> cancels — and
                a drag draws a region instead.
            </p>
        </dd>
    </div>

    <div>
        <dt>Sending<span class="purpose">nothing you did not see</span></dt>
        <dd>
            <p>
                Each channel is a switch showing its own size, and
                <em>what will be sent</em> renders the exact payload
                before it goes. Form values, password fields and
                anything marked
                <code>data-corrigenda-redact</code> never leave the
                page.
            </p>
        </dd>
    </div>

    <div>
        <dt>Screenshots<span class="purpose">your real rendering</span></dt>
        <dd>
            <p>
                Taken through the browser's own capture permission, so
                the image is the page as it actually drew — not a
                redrawing of how it was meant to look. Cropping to the
                element and the bars over form fields need a frame that
                maps to the page: share <strong>this tab</strong>, or
                <a href="#add-on">install the add-on</a> and skip the question.
            </p>
        </dd>
    </div>
</dl>

<h2>Where it works</h2>

<dl class="railed">
<% if endpoint %>
    <dt>This endpoint</dt>
    <dd>
<p><code><%= endpoint %></code></p>
<p>Where this page came from, and where its reports go. The
paths below are relative to it.</p>

<table class="paths">
    <tbody>
        <tr>
            <td><code>/corrigenda.js</code></td>
            <th scope="row">Anyone</th>
            <td>The widget. Every page carrying it fetches it,
            visitors included, so this is the one path here that
            asks for no login.</td>
        </tr>
        <tr>
            <td><code>/report/</code></td>
            <th scope="row">Signed in</th>
            <td>Where a report is posted, and
            <code>/report/health</code> beside it.</td>
        </tr>
        <tr>
            <td><code>/review/</code></td>
            <th scope="row">Signed in</th>
            <td>The reports, and everything sent with them.</td>
        </tr>
        <tr>
            <td><code>/extension/…</code></td>
            <th scope="row">Signed in</th>
            <td>The add-on packages, the signing notes, and this
            page.</td>
        </tr>
    </tbody>
</table>
    </dd>
<% end %>

    <dt>Reports about</dt>
    <dd>
        <% if sites.nil? %>
            Any site — no allowlist configured.
        <% else %>
            <% sites.each do |site| %>
                <code><%= site %></code><br>
            <% end %>
            <p>What a report may claim to be about. One naming anything
            else is refused.</p>
        <% end %>
    </dd>

    <dt>Posted from</dt>
    <dd>
        <% if origins.nil? %>
            Any origin — no allowlist configured.
        <% else %>
            <% origins.each do |origin| %>
                <code><%= origin %></code><br>
            <% end %>
            <p>Which pages may send one from another host. A page
            elsewhere is stopped by its own browser: the answer to the
            preflight does not name it.</p>
        <% end %>
    </dd>

    <% if endpoint %>
        <dt>Point a site here</dt>
        <dd>
            <p>A site rendered by
            <a href="https://gitlab.com/sdalu/moxow">MoXoW</a> names this
            endpoint before the vertical bar, and says who gets the widget
            after it:</p>
            <pre><code>&lt;m:framework corrigenda="<%= endpoint.sub(%r{/\.corrigenda\z}, "") %>|yes"/&gt;</code></pre>
            <p>A site that mounts the service itself (<code>Use
            CorrigendaEndpoint</code> in its vhost) leaves the endpoint
            out: the widget posts to its own origin then, which needs no
            CORS. Either way the page advertises where reports go, so a
            bookmarklet or the add-on finds it without being told.</p>
        </dd>
    <% end %>
</dl>

<h2>State</h2>

<dl class="railed">
    <dt>Reports</dt>
    <dd><a href="<%= mount("/review/") %>"><%= count %> stored</a></dd>

    <dt>Latest</dt>
    <dd><%= latest ? "#{latest["at"]} — #{latest["url"]}" : "Nothing reported yet." %></dd>

    <dt>Store</dt>
    <dd><code><%= store_path %></code></dd>

    <dt>Endpoint</dt>
    <dd><a href="<%= mount("/report/health") %>">health</a></dd>
</dl>

<script>
    /* The app is behind a proxy and is not told its public URL. The
       browser knows it: this page came from it. */
    (function () {
        /* The page it lands on may already say where its reports go —
           MoXoW puts <link rel="corrigenda"> on every page of a site the
           widget is configured for. Reading it means a bookmarklet made
           here still does the right thing on a site with its own
           endpoint. Where nothing is advertised, this endpoint is the
           fallback, and the tag carries it: without that the client
           would post to the page's own origin, which is a 404 on any
           site that does not mount the service. */
        var here = location.origin + "<%= mount("") %>";
        var code = "javascript:(function(){" +
                   "var l=document.querySelector('link[rel=corrigenda]')," +
                   "b=(l&&l.href||'" + here + "').replace(/[/]+$/,'')," +
                   "s=document.createElement('script');" +
                   "s.src=b+'/corrigenda.js';" +
                   "s.dataset.endpoint=b+'/report/';" +
                   "document.documentElement.appendChild(s);})();";
        document.querySelector(".bookmarklet").href = code;
        document.querySelector(".bookmarklet-source").textContent = code;

        /* Clipboard access is refused outside a secure context, and this
           page is served over plain http on a development run — so the
           button says what happened either way rather than appearing to
           work. */
        var button = document.querySelector(".a-copy");
        button.addEventListener("click", function () {
            var done = function (word) {
                button.textContent = word;
                setTimeout(function () { button.textContent = "Copy"; }, 1500);
            };

            if (!navigator.clipboard) return done("Select it");

            navigator.clipboard.writeText(code)
                .then(function () { done("Copied"); },
                      function () { done("Select it"); });
        });
    })();
</script>
