<% target      = document["target"] || {} %>
<% rules       = target["rules"] || [] %>
<% audit       = target["audit"] %>
<% diagnostics = document["diagnostics"] || {} %>
<% environment = document["environment"] || {} %>

<h1><%= document["type"] %> report</h1>

<p class="lede">
    <span class="badge is-<%= state %>"><%= state %></span>
    <a href="<%= document.dig("page", "url") %>"><%= document.dig("page", "url") %></a>
</p>

<% unless document["message"].to_s.empty? %>
    <h2>Message</h2>
    <p><%= document["message"] %></p>
<% end %>

<% if target["selector"] %>
    <h2>Target</h2>
    <p><code><%= target["selector"] %></code></p>
    <%# A region report and a text report both name more than one
        element: what the rectangle covered, what held the words. The
        selector above is where to open the page; this is what the
        report is actually about. %>
    <% unless (covers = target["covers"] || []).empty? %>
        <p class="empty">
            <% if target["region"] %>
                Covering <%= covers.length %>
                element<%= "s" unless covers.length == 1 %>:
            <% else %>
                The words are in <%= covers.length %>
                element<%= "s" unless covers.length == 1 %>:
            <% end %>
        </p>
        <ul class="covers">
            <% covers.each do |selector| %>
                <li><code><%= selector %></code></li>
            <% end %>
        </ul>
    <% end %>
<% end %>

<% unless rules.empty? %>
    <h2>What styled it</h2>
    <% rules.each do |rule| %>
        <ol class="cascade">
            <% rule["context"].to_s.split(" / ").reject(&:empty?).each do |band| %>
                <li><%= band %></li>
            <% end %>
            <li class="is-selector"><%= rule["selector"] %>
                <span class="where"><%= rule["href"] %></span>
            </li>
        </ol>
    <% end %>
    <% if (unreadable = target["unreadable"]) && !unreadable.empty? %>
        <p class="empty">
            Not readable from the page, so not searched:
            <%= unreadable.join(", ") %>.
        </p>
    <% end %>
<% end %>

<% if audit %>
    <h2>Accessibility</h2>
    <dl class="railed">
        <% audit.each do |key, value| %>
            <dt><%= key %></dt>
            <dd><%= value %></dd>
        <% end %>
    </dl>
<% end %>

<% if files.include?("screenshot.webp") %>
    <h2>Screenshot</h2>
    <img class="shot" src="<%= to("/#{id}/file/screenshot.webp", false) %>"
         alt="Screenshot submitted with this report">
<% end %>

<% if target["html"] %>
    <h2>Fragment</h2>
    <iframe class="fragment" sandbox srcdoc="<%= target["html"] %>"
            title="The reported fragment, rendered in isolation"></iframe>
<% end %>

<% unless diagnostics.empty? %>
    <h2>What else went wrong</h2>
    <dl class="railed">
        <% errors = diagnostics["errors"] || [] %>
        <dt>Errors</dt>
        <dd>
            <% if errors.empty? %>None<% else %>
                <% errors.each do |error| %>
                    <code><%= error["message"] %></code>
                    <% if error["source"] %>
                        <span class="where"><%= error["source"] %>:<%= error["line"] %></span>
                    <% end %>
                    <br>
                <% end %>
            <% end %>
        </dd>

        <% resources = diagnostics["resources"] || [] %>
        <dt>Failed loads</dt>
        <dd>
            <% if resources.empty? %>None<% else %>
                <% resources.each do |resource| %>
                    <code><%= resource["url"] %></code><br>
                <% end %>
            <% end %>
        </dd>

        <% overflow = diagnostics["overflow"] || {} %>
        <dt>Sideways overflow</dt>
        <dd>
            <% if overflow["overflows"] %>
                <%= overflow["scrollWidth"] %>px in a
                <%= overflow["clientWidth"] %>px viewport —
                <% (overflow["offenders"] || []).each do |offender| %>
                    <code><%= offender %></code>
                <% end %>
            <% else %>
                None
            <% end %>
        </dd>
    </dl>
<% end %>

<% unless environment.empty? %>
    <h2>Environment</h2>
    <dl class="railed">
        <% environment.each do |key, value| %>
            <dt><%= key %></dt>
            <dd><%= value %></dd>
        <% end %>
    </dl>
<% end %>

<h2>State</h2>

<form class="states" method="post" action="<%= to("/#{id}/state", false) %>">
    <% DebugFeedback::Store::STATES.each do |value| %>
        <button name="state" value="<%= value %>"<%= value == state ? " disabled" : "" %>><%= value %></button>
    <% end %>
</form>

<p class="empty">
    <a href="<%= to("/#{id}/file/report.json", false) %>">report.json</a>
    — everything above, as it was received.
</p>
