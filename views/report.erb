<% target      = document["target"] || {} %>
<% rules       = target["rules"] || [] %>
<% audit       = target["audit"] %>
<% diagnostics = document["diagnostics"] || {} %>
<% environment = document["environment"] || {} %>

<h1><%= document["type"] %> report</h1>

<p class="lede">
    <span class="badge is-<%= state %>"><%= state %></span>
    <% if archived %><span class="badge is-archived">archived</span><% end %>
    <a href="<%= document.dig("page", "url") %>"><%= document.dig("page", "url") %></a>
</p>

<% unless document["message"].to_s.empty? %>
    <h2>Message</h2>
    <p><%= document["message"] %></p>
<% end %>

<% if target["selector"] %>
    <h2>Target</h2>
    <p><code><%= target["selector"] %></code></p>
    <%# A region report and a text report both name more than one
        element: what the rectangle covered, what held the words. The
        selector above is where to open the page; this is what the
        report is actually about. %>
    <% unless (covers = target["covers"] || []).empty? %>
        <p class="empty">
            <% if target["region"] %>
                Covering <%= covers.length %>
                element<%= "s" unless covers.length == 1 %>:
            <% else %>
                The words are in <%= covers.length %>
                element<%= "s" unless covers.length == 1 %>:
            <% end %>
        </p>
        <ul class="covers">
            <% covers.each do |selector| %>
                <li><code><%= selector %></code></li>
            <% end %>
        </ul>
    <% end %>
<% end %>

<% unless rules.empty? %>
    <h2>What styled it</h2>
    <%# The selector is what you came for; the layers and queries above
        it are why it applied, which is a second question and not always
        asked. So the selector is the summary and the strata are what
        opens — a report on a heavily styled element carries a dozen of
        these, and a dozen four-line blocks is a wall.

        A rule with no context has nothing to open, and says so by not
        being a disclosure at all. %>
    <% rules.each do |rule| %>
        <% bands = rule["context"].to_s.split(" / ").reject(&:empty?) %>
        <% if bands.empty? %>
            <p class="rule is-bare">
                <span class="selector"><%= rule["selector"] %></span>
                <span class="where"><%= rule["href"] %></span>
            </p>
        <% else %>
            <details class="rule">
                <summary>
                    <span class="selector"><%= rule["selector"] %></span>
                    <span class="where"><%= rule["href"] %></span>
                    <span class="depth"><%= bands.length %> deep</span>
                </summary>
                <%# A band is one of three things, and they answer three
                    different questions: which layer it sits in, what
                    had to be true for it to apply, and what it was
                    nested inside. The edge says which without a word. %>
                <ol class="cascade">
                    <% bands.each do |band| %>
                        <% kind = if band.start_with?("@layer") then "layer"
                                  elsif band.start_with?("@")   then "condition"
                                  else                               "nesting"
                                  end %>
                        <li class="is-<%= kind %>"><%= band %></li>
                    <% end %>
                </ol>
            </details>
        <% end %>
    <% end %>
    <% if (unreadable = target["unreadable"]) && !unreadable.empty? %>
        <p class="empty">
            Not readable from the page, so not searched:
            <%= unreadable.join(", ") %>.
        </p>
    <% end %>
<% end %>

<% if audit %>
    <h2>Accessibility</h2>
    <dl class="railed">
        <% audit.each do |key, value| %>
            <dt><%= key %></dt>
            <dd><%= value %></dd>
        <% end %>
    </dl>
<% end %>

<% if files.include?("screenshot.webp") %>
    <h2>Screenshot</h2>
    <img class="shot" src="<%= to("/#{id}/file/screenshot.webp", false) %>"
         alt="Screenshot submitted with this report">
<% end %>

<% if target["html"] %>
    <h2>Fragment</h2>
    <%# The fragment is a piece of another page and carries that page's
        relative URLs. Without a base they resolve against this one:
        every image in a reported card asks the review app for a report
        named photo.jpg. With it they resolve where they were written,
        so the fragment renders as it did -- and the requests stop
        arriving here at all. Sandboxed with no allow-same-origin, so
        the frame stays inert whatever it loads. %>
    <iframe class="fragment" sandbox
            srcdoc="<%= "<base href=\"#{document.dig("page", "url")}\">" %><%= target["html"] %>"
            title="The reported fragment, rendered in isolation"></iframe>
<% end %>

<% unless diagnostics.empty? %>
    <h2>What else went wrong</h2>
    <dl class="railed">
        <% errors = diagnostics["errors"] || [] %>
        <dt>Errors</dt>
        <dd>
            <% if errors.empty? %>None<% else %>
                <% errors.each do |error| %>
                    <code><%= error["message"] %></code>
                    <% if error["source"] %>
                        <span class="where"><%= error["source"] %>:<%= error["line"] %></span>
                    <% end %>
                    <br>
                <% end %>
            <% end %>
        </dd>

        <% resources = diagnostics["resources"] || [] %>
        <dt>Failed loads</dt>
        <dd>
            <% if resources.empty? %>None<% else %>
                <% resources.each do |resource| %>
                    <code><%= resource["url"] %></code><br>
                <% end %>
            <% end %>
        </dd>

        <% overflow = diagnostics["overflow"] || {} %>
        <dt>Sideways overflow</dt>
        <dd>
            <% if overflow["overflows"] %>
                <%= overflow["scrollWidth"] %>px in a
                <%= overflow["clientWidth"] %>px viewport —
                <% (overflow["offenders"] || []).each do |offender| %>
                    <code><%= offender %></code>
                <% end %>
            <% else %>
                None
            <% end %>
        </dd>
    </dl>
<% end %>

<% unless environment.empty? %>
    <h2>Environment</h2>
    <dl class="railed">
        <% environment.each do |key, value| %>
            <dt><%= key %></dt>
            <dd><%= value %></dd>
        <% end %>
    </dl>
<% end %>

<h2>State</h2>

<div class="states">
    <%# The list shows the state it is in, in that state’s own colour,
        and keeps the other two out of the way until they are asked
        for. Picking one colours the box straight away — what you are
        about to do is on the screen while you decide — and the button
        beside it is what commits. %>
    <form class="pick" method="post"
          action="<%= to("/#{id}/state", false) %>">
        <select name="state" aria-label="State">
            <% Corrigenda::Store::STATES.each do |value| %>
                <option value="<%= value %>"<%=
                    " selected" if value == state %>><%= value %></option>
            <% end %>
        </select>
        <button>Set</button>
    </form>

    <%# Archiving says nothing about the defect -- a report is archived
        and fixed, or archived and wontfix -- so it is its own control,
        outside the segment, and deleting is not a state at all. %>
    <form class="filing" method="post"
          action="<%= to("/#{id}/archive", false) %>">
        <input type="hidden" name="archived" value="<%= archived ? "0" : "1" %>">
        <button class="toggle" role="switch" aria-checked="<%= archived %>"
                title="<%= archived ? "Bring it back to the working list" : "Out of the list, keeping everything" %>">Archived</button>
    </form>

    <%# At the other end of the row: it is the one press here that
        cannot be taken back, and it should not sit a thumb's width
        from the one that files the report. %>
    <form class="apart" method="post"
          action="<%= to("/#{id}/delete", false) %>">
        <button class="is-danger">Delete…</button>
    </form>
</div>

<p class="empty">
    Archiving takes it out of the list and keeps everything. Deleting
    asks once more, then removes the report and its files from disk.
</p>

<%# What has been done about it. Only shown when there is something to
    show: an empty heading on every report nobody has touched is a page
    that trains you to skip a section. %>
<% unless journal.empty? %>
    <h2>What has been done</h2>

    <dl class="railed trail">
        <% journal.each do |entry| %>
            <dt><time datetime="<%= entry["at"] %>"><%= entry["at"].to_s[0, 16].tr("T", " ") %></time></dt>
            <dd>
                <%= entry["note"] %>
                <% who = [entry["by"], entry["agent"]].compact %>
                <% unless who.empty? %>
                    <span class="by"><%= who.join(" · ") %></span>
                <% end %>
                <% if entry["refs"] %>
                    <span class="by"><%= entry["refs"].join(", ") %></span>
                <% end %>

                <%# The picture this line carries: what the page looked
                    like after the step. The one the report was filed
                    with sits beside it on request, which is the
                    comparison somebody actually wants and the reason a
                    trail carries pictures at all. %>
                <% if entry["shot"] %>
                    <% shot = to("/#{id}/file/#{entry["shot"]}", false) %>
                    <figure class="after">
                        <a href="<%= shot %>">
                            <img class="shot" src="<%= shot %>" loading="lazy"
                                 alt="The page after: <%= entry["note"] %>">
                        </a>

                        <% if files.include?("screenshot.webp") %>
                            <details>
                                <summary>beside the original</summary>
                                <div class="pair">
                                    <figure>
                                        <img class="shot" loading="lazy"
                                             src="<%= to("/#{id}/file/screenshot.webp", false) %>"
                                             alt="The page as reported">
                                        <figcaption>as reported</figcaption>
                                    </figure>
                                    <figure>
                                        <img class="shot" src="<%= shot %>" loading="lazy"
                                             alt="The page after: <%= entry["note"] %>">
                                        <figcaption><%= entry["at"].to_s[0, 16].tr("T", " ") %></figcaption>
                                    </figure>
                                </div>
                            </details>
                        <% end %>
                    </figure>
                <% end %>
            </dd>
        <% end %>
    </dl>

    <p class="empty">
        Appended, never rewritten. A state changed through the API or on
        the command line writes its own line here.
    </p>
<% end %>

<p class="empty">
    <a href="<%= to("/#{id}/file/report.json", false) %>">report.json</a>
    — everything above, as it was received.
</p>
