<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Debug feedback</title>
<style>
@layer tokens, base, layout, components;

@layer tokens {
    :root {
        color-scheme: light dark;
        --surface: light-dark(oklch(99% 0 0),       oklch(21% 0.01 260));
        --raised:  light-dark(oklch(96% 0.004 260), oklch(26% 0.01 260));
        --ink:     light-dark(oklch(24% 0.01 260),  oklch(94% 0.01 260));
        --muted:   light-dark(oklch(44% 0.015 260), oklch(74% 0.02 260));
        --line:    light-dark(oklch(84% 0.01 260),  oklch(40% 0.015 260));
        --accent:  light-dark(oklch(45% 0.16 255),  oklch(80% 0.12 255));
        --space:   1rem;
    }
}

@layer base {
    *, *::before, *::after { box-sizing: border-box; }

    body {
        margin: 0;
        padding-block: var(--space);
        font-family: system-ui, sans-serif;
        line-height: 1.5;
        color: var(--ink);
        background: var(--surface);
        overflow-wrap: break-word;
    }

    h1, h2 {
        margin-block: 1.5rem 0.5rem;
        line-height: 1.2;
        text-wrap: balance;
    }

    a { color: var(--accent); }

    :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    code, pre { font-family: ui-monospace, monospace; }
}

@layer layout {
    .page {
        container-type: inline-size;
        inline-size: min(100% - 2 * var(--space), 78rem);
        margin-inline: auto;
    }

    /* Wide content scrolls inside its own box; the page never does. */
    .scroller { overflow-x: auto; }
}

@layer components {
    .listing {
        border-collapse: collapse;
        inline-size: 100%;

        th, td {
            padding: 0.5rem;
            border-block-end: 1px solid var(--line);
            text-align: start;
            vertical-align: top;
        }

        th { color: var(--muted); font-weight: 600; }

        td code { font-size: 0.875em; }
    }

    .badge {
        display: inline-block;
        padding-inline: 0.5em;
        border: 1px solid var(--line);
        border-radius: 0.25em;
        font-size: 0.875rem;

        /* The word is the state; the colour only seconds it. */
        &.is-open    { border-color: var(--accent); }
        &.is-fixed   { color: var(--muted); }
        &.is-wontfix { color: var(--muted); font-style: italic; }
    }

    .states {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;

        button {
            min-block-size: 2.75rem;
            min-inline-size: 2.75rem;
            padding-inline: var(--space);
            font: inherit;
            color: var(--ink);
            background: var(--raised);
            border: 1px solid var(--line);
            border-radius: 0.25em;

            &:disabled { color: var(--muted); }
        }
    }

    pre, .fragment {
        padding: var(--space);
        background: var(--raised);
        border: 1px solid var(--line);
    }

    pre { overflow-x: auto; }

    .fragment {
        inline-size: 100%;
        min-block-size: 14rem;
    }

    .lede { font-size: 1.125rem; color: var(--muted); max-inline-size: 60ch; }

    dl {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem var(--space);
        align-items: baseline;

        dt { font-weight: 600; }
        dd { margin: 0; }

        /* One column when the terms and their prose cannot share a row. */
        @container (inline-size < 34rem) {
            grid-template-columns: 1fr;

            dd { margin-block-end: var(--space); }
        }
    }

    kbd {
        padding-inline: 0.35em;
        font-family: ui-monospace, monospace;
        font-size: 0.875em;
        border: 1px solid var(--line);
        border-radius: 0.25em;
    }

    .bookmarklet {
        display: inline-block;
        min-block-size: 2.75rem;
        padding: 0.6rem var(--space);
        color: light-dark(white, black);
        background: var(--accent);
        border-radius: 0.4rem;
        text-decoration: none;
        font-weight: 600;
        cursor: grab;
    }

    .bookmarklet-source { white-space: pre-wrap; word-break: break-all; }

    .shot {
        max-inline-size: 100%;
        block-size: auto;
        border: 1px solid var(--line);
    }
}
</style>
</head>
<body>
<main class="page">
<%== yield %>
</main>
</body>
</html>
