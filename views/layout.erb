<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Corrigenda</title>
<link rel="icon" href="<%= mount("/icon.svg") %>" type="image/svg+xml">
<style>
/* The estate's own faces, served by the same vhost. Absent (a local run
   with no /common alias) the stacks below fall back and nothing breaks. */
@font-face {
    font-family: "PT Sans Narrow";
    src: url("/common/fonts/PT_Sans-Narrow-Web-Bold.woff2") format("woff2");
    font-weight: 700;
    font-display: swap;
}
@font-face {
    font-family: "Alegreya Sans";
    src: url("/common/fonts/AlegreyaSans-Regular.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
}
@font-face {
    font-family: "Alegreya Sans";
    src: url("/common/fonts/AlegreyaSans-Medium.woff2") format("woff2");
    font-weight: 500;
    font-display: swap;
}

<%# `vendor` sits between our base and our components: a third-party
    stylesheet may reset what it needs inside its own subtree, and we
    still get the last word about it. Naming it here is what makes that
    true — a stylesheet loaded outside every layer beats all of them,
    however specific ours are, which is how the schema viewer's version
    badges ended up white on white. %>
@layer reset, tokens, base, vendor, layout, components, utilities;

@layer reset {
    *, *::before, *::after { box-sizing: border-box; }

    body, h1, h2, h3, p, dl, dd, ol, ul, figure { margin: 0; }
    ol, ul { padding: 0; list-style: none; }
}

@layer tokens {
    :root {
        color-scheme: light dark;

        /* Paper and graphite: an instrument reads as a measurement, not
           as a brand. Amber is the only saturated colour and it is
           reserved for state and for the one action worth taking. */
        --paper:  light-dark(oklch(98.5% 0.004 95), oklch(18% 0.012 265));
        --panel:  light-dark(oklch(96%   0.006 95), oklch(22% 0.014 265));
        --ink:    light-dark(oklch(24%   0.012 265), oklch(93% 0.008 95));
        --muted:  light-dark(oklch(45%   0.014 265), oklch(72% 0.012 95));
        --rule:   light-dark(oklch(87%   0.008 95),  oklch(33% 0.014 265));
        --signal: light-dark(oklch(72%   0.15  70),  oklch(78% 0.14  70));
        --link:   light-dark(oklch(45%   0.12 250),  oklch(80% 0.10 250));

        /* The second saturated colour, and it is spent on one
           thing: the button that destroys a report. Amber says
           "look"; this says "gone". */
        --danger: light-dark(oklch(48%   0.19 25),   oklch(74% 0.16 25));

        /* Lifted from the widget, value for value: the same three hues
           it outlines a parent, a child and a sibling with while you
           pick. Repeated rather than shared because there is nothing to
           share them through — one lives in a shadow root on somebody
           else's page — so they are written once here and once there,
           and changing one means changing both. */
        --parent:  light-dark(oklch(62% 0.16 55),  oklch(74% 0.15 55));
        --child:   light-dark(oklch(52% 0.14 150), oklch(70% 0.14 150));
        --sibling: light-dark(oklch(55% 0.18 305), oklch(74% 0.15 305));

        /* The three kinds of cascade band. Blue and teal were 55° apart
           and a low-chroma grey read as a third shade of the same idea;
           at 2px, on a panel, that is three greys. So they are pulled
           to opposite ends of the wheel and given a second axis as
           well — nesting is dotted, not merely paler, which survives
           both a small edge and a reader who does not separate hues. */
        --band-layer:     light-dark(oklch(45% 0.19 285), oklch(76% 0.15 285));
        --band-condition: light-dark(oklch(58% 0.16 145), oklch(72% 0.15 145));
        --band-nesting:   light-dark(oklch(55% 0.02 265), oklch(62% 0.02 265));

        --display: "PT Sans Narrow", "PT Sans", ui-sans-serif, sans-serif;
        --body:    "Alegreya Sans", ui-sans-serif, system-ui, sans-serif;
        --mono:    ui-monospace, "SFMono-Regular", "Consolas", monospace;

        --space: 1rem;
        --measure: 68ch;
    }
}

@layer base {
    body {
        padding-block-end: 4rem;
        font-family: var(--body);
        font-size: 1.0625rem;
        line-height: 1.55;
        color: var(--ink);
        background: var(--paper);
        overflow-wrap: break-word;
    }

    h1, h2, h3 { line-height: 1.15; text-wrap: balance; }

    h1 {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(2rem, 1.4rem + 2.6vw, 3.2rem);
        letter-spacing: 0.01em;
    }

    h2 {
        margin-block: 2.5rem 0.75rem;
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: 0.02em;
    }

    p { max-inline-size: var(--measure); }

    a {
        color: var(--link);
        text-underline-offset: 0.15em;
    }

    code, pre, kbd { font-family: var(--mono); font-size: 0.9em; }

    :focus-visible {
        outline: 2px solid var(--signal);
        outline-offset: 3px;
    }

    strong { font-weight: 500; }
}

@layer layout {
    .page {
        container-type: inline-size;
        inline-size: min(100% - 2 * var(--space), 60rem);
        margin-inline: auto;
    }

    /* The landing page is a workbench — a bookmarklet to drag, a state
       readout, a specimen — not an essay, so it takes far more of the
       window than a column of prose would. What it holds is uncapped
       with it, in the utilities layer: a capped paragraph inside an
       uncapped page reads as a mistake.

       Bounded all the same: past this the page stops being wide and
       starts being sparse, with the eye travelling further than the
       content is worth. */
    .page.is-wide {
        inline-size: min(100% - 2 * var(--space), 72rem);
    }

    /* Structural labels live in the margin at width, above at narrow —
       the label is a marginal note, not a heading. */
    /* minmax(0, 1fr) rather than a bare track: a grid column's automatic
       minimum is min-content, so one wide child -- the paths table --
       set the width of this list, the list set the width of the page,
       and the page scrolled sideways on a phone. The floor of 0 lets
       the column be as narrow as the screen and leaves the wide child
       to say what it does about that (see .scroller). */
    .railed {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.35rem var(--space);

        @container (inline-size > 44rem) {
            grid-template-columns: 9rem minmax(0, 1fr);
            gap: 1.1rem var(--space);
        }
    }

    .scroller { overflow-x: auto; }
}

@layer components {
    .masthead {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem var(--space);
        align-items: baseline;
        justify-content: space-between;
        padding-block: 1.25rem;
        margin-block-end: 2rem;
        border-block-end: 1px solid var(--rule);
    }

    .eyebrow {
        font-family: var(--display);
        font-weight: 700;
        font-size: 0.8125rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
    }

    /* Which checkout is answering. Worth a line on every page: the whole
       service is about pages that behave unlike the ones you tested, and
       the first thing to ask of a report is what was serving the widget
       that filed it. */
    .colophon {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.75rem;
        justify-content: space-between;
        padding-block: 1.25rem;
        margin-block-start: 3rem;
        border-block-start: 1px solid var(--rule);
        font-size: 0.875rem;
        color: var(--muted);
    }

    .masthead nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space);

        a {
            font-family: var(--display);
            font-size: 0.9375rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }
    }

    /* The signature: a matched rule is not a row in a table, it is a
       position in the cascade. Each band is one step of the context that
       had to be true for the rule to apply, the selector last. */
    .cascade {
        display: grid;
        gap: 2px;
        max-inline-size: var(--measure);
        font-family: var(--mono);
        font-size: 0.875rem;

        li {
            padding: 0.4rem 0.7rem;
            background: var(--panel);
            border-inline-start: 2px solid var(--rule);
        }

        /* One hue per kind of band, because they answer three different
           questions: where in the cascade, under what condition, and
           inside what. The prefix says it too — @layer, @media — but
           the edge says it before you read, which is the point of a
           stack you scan rather than parse. */
        .is-layer {
            border-inline-start: 3px solid var(--band-layer);
        }

        .is-condition {
            border-inline-start: 3px solid var(--band-condition);
        }

        /* Dotted, and only 2px: nesting is not a third colour, it is
           the absence of one. Nothing had to be true for it — the rule
           was simply written inside something. */
        .is-nesting {
            border-inline-start: 2px dotted var(--band-nesting);
        }

        li:nth-child(2) { margin-inline-start: 0.9rem; }
        li:nth-child(3) { margin-inline-start: 1.8rem; }
        li:nth-child(4) { margin-inline-start: 2.7rem; }

        .is-selector {
            border-inline-start-color: var(--signal);
            font-weight: 500;
        }

        .where {
            display: block;
            font-family: var(--body);
            font-size: 0.8125rem;
            color: var(--muted);
        }
    }

    .cascade + .cascade { margin-block-start: 0.9rem; }

    /* One matched rule. The summary carries the selector and wears the
       signal edge the strata used to end on, so a closed list still
       reads as a stack of rules that matched. Open, the context steps
       out beneath it exactly as before. */
    .rule {
        max-inline-size: var(--measure);
        margin-block-start: 0.4rem;
        font-family: var(--mono);
        font-size: 0.875rem;

        summary, &.is-bare {
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem 0.7rem;
            align-items: baseline;
            padding: 0.4rem 0.7rem;
            background: var(--panel);
            border-inline-start: 2px solid var(--signal);
            cursor: pointer;
        }

        /* A flex summary loses the marker the browser would have drawn,
           and a disclosure with nothing to disclose it by is a row that
           happens to react to clicks. The bare rule gets a space in its
           place, so the selectors line up down the column. */
        summary::before {
            content: "▸";
            color: var(--muted);
        }

        &[open] summary::before { content: "▾"; }

        &.is-bare {
            cursor: default;

            &::before { content: "·"; color: var(--rule); }
        }

        .selector { font-weight: 500; }

        .where, .depth {
            font-family: var(--body);
            font-size: 0.8125rem;
            color: var(--muted);
        }

        /* Pushed to the end, where it reads as an aside rather than as
           part of the selector. */
        .depth { margin-inline-start: auto; }

        .cascade {
            margin-block-start: 2px;
            margin-inline-start: 0.9rem;
        }

        &[open] summary { border-inline-start-color: var(--ink); }
    }

    /* Siblings, not strata: these elements are a flat list of what one
       report is about, so nothing here steps to the right the way the
       cascade does. */
    .covers {
        display: grid;
        gap: 2px;
        max-inline-size: var(--measure);
        margin-block-start: 0.4rem;
        font-family: var(--mono);
        font-size: 0.875rem;
        list-style: none;

        li {
            padding: 0.3rem 0.7rem;
            background: var(--panel);
            border-inline-start: 2px solid var(--rule);
            overflow-wrap: anywhere;
        }
    }

    .specimen {
        padding: var(--space);
        border: 1px solid var(--rule);
        border-radius: 2px;
        background: color-mix(in oklab, var(--signal) 5%, var(--paper));

        figcaption {
            margin-block-end: 0.6rem;
            font-family: var(--display);
            font-size: 0.8125rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--muted);
        }
    }

    .lede {
        max-inline-size: 46ch;
        margin-block: 0.75rem 2rem;
        font-size: 1.25rem;
        line-height: 1.4;
        color: var(--muted);
    }

    /* A remark, and a remark that costs you something. "Every browser
       strips it" is not a footnote: it is the thing you are about to try,
       and it will not work. Tinted, so the plain remarks around it stay
       plain. */
    .caveat {
        max-inline-size: var(--measure);
        margin-block-start: 0.6rem;
        font-size: 0.9375rem;
        color: var(--muted);

        &.is-warning {
            padding: 0.5rem 0.7rem;
            color: var(--ink);
            background: color-mix(in oklab, var(--signal) 16%, transparent);
            border-inline-start: 3px solid var(--signal);
        }
    }

    .bookmarklet {
        display: inline-block;
        min-block-size: 2.75rem;
        padding: 0.65rem 1.1rem;
        font-family: var(--display);
        font-size: 1.0625rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: oklch(24% 0.012 265);
        background: var(--signal);
        border: 1px solid transparent;
        border-radius: 2px;
        text-decoration: none;
        cursor: grab;

        &:hover { border-color: var(--ink); }
    }

    /* Two packages, read against each other. What they share is said
       once above them; each box carries the line that differs, the
       button, and the two steps it takes — so the eye compares rows
       rather than paragraphs, and neither box is furniture. */
    .packages {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
        gap: var(--space);
        margin-block-start: 0.6rem;

        /* The name and what it can do read left to right; the thing you
           came to press sits in the corner where a button belongs, with
           its weight underneath rather than beside it. The description
           column is bounded so a long line cannot slide under it. */
        > div {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            column-gap: 0.75rem;
            align-content: start;
            padding: 0.75rem 0.9rem;
            background: var(--panel);
            border: 1px solid var(--rule);
        }

        dt { grid-column: 1; }
        dd { grid-column: 1; }

        /* Both columns, under everything: what it says is about the
           package, not about the line it happened to sit beside, and it
           is the widest sentence in the box. */
        .caveat { grid-column: 1 / -1; }

        .get {
            grid-column: 2;
            grid-row: 1 / span 2;
            justify-self: end;
            /* Hugs the top corner rather than stretching down the box:
               a grid item fills its area unless told not to. */
            align-self: start;
        }

        dt {
            font-family: var(--display);
            font-weight: 700;
            font-size: 1.0625rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        dd { margin: 0.4rem 0 0; }

        .caveat { font-size: 0.8125rem; }
    }

    /* Ticks and dashes rather than prose: what separates the two
       packages is one line long, and a reader should see it without
       reading it. */
    .can {
        display: grid;
        gap: 0.2rem;
        font-size: 0.9375rem;

/* What both browsers do, on the same panel as the boxes below
 and spanning the width of both: it belongs to the pair, not
 to either one. Spaced apart rather than left-packed, so the
 three read as three rather than as a sentence. */
&.is-shared {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  gap: 0.3rem 1.5rem;
  margin-block-start: 0.75rem;
  padding: 0.6rem 0.9rem;
  color: var(--muted);
  background: var(--panel);
  border: 1px solid var(--rule);
}

        li {
            padding-inline-start: 1.4rem;
            text-indent: -1.4rem;
        }

        li::before {
            display: inline-block;
            inline-size: 1.4rem;
            text-indent: 0;
            font-family: var(--mono);
        }

        .is-yes::before { content: "✓"; color: var(--signal); }

        /* Not a failure, a boundary — so a dash, not a cross. */
        .is-no::before { content: "–"; color: var(--muted); }
        .is-no { color: var(--muted); }
    }

    .get {
        display: grid;
        gap: 0.25rem;
        justify-items: end;
        margin: 0;
        text-align: end;
    }

    .steps {
        display: grid;
        gap: 0.15rem;
        margin-block-start: 0.5rem;
        padding-inline-start: 1.3rem;
        list-style: decimal;
        font-size: 0.875rem;
        color: var(--muted);
    }

    /* Four boxes, because they are four choices made at the same moment
       — read against each other rather than down a list. They hold
       their own row while there is room for four and fold in pairs
       before they fold flat. */
    .kinds {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
        gap: var(--space);
        margin-block-start: 0.75rem;

        /* Three of something wants a wider track than four of it, or
           auto-fit puts four across and leaves one short. */
        &.is-three {
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
        }

        > div {
            display: grid;
            /* The prose settles to the bottom, so the marks line up
               across boxes whatever the descriptions do. */
            grid-template-rows: auto 1fr;
            padding: 0.9rem 1rem;
            background: var(--panel);
            border: 1px solid var(--rule);
        }

        dt {
            font-family: var(--display);
            font-weight: 700;
            font-size: 1.0625rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .purpose {
            display: block;
            font-family: var(--body);
            font-size: 0.875rem;
            font-weight: 400;
            letter-spacing: 0;
            text-transform: none;
            color: var(--muted);
        }

        dd { margin: 0.6rem 0 0; }

        .marks {
            display: flex;
            flex-wrap: wrap;
            gap: 0.2rem;
            margin-block-end: 0.5rem;

            .empty { padding: 0; font-size: 0.875rem; }
        }
    }

    /* The same signal as the bookmarklet, hollow: both are ways to get
       the widget, and neither is the more important one. */
    .package {
        display: inline-block;
        min-block-size: 2.25rem;
        padding: 0.45rem 0.9rem;
        font-family: var(--display);
        font-size: 0.9375rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink);
        border: 1px solid var(--signal);
        border-radius: 2px;
text-decoration: none;

/* Font Awesome Free download arrow (CC BY 4.0), sized to the
 word beside it rather than to a pixel count, so the two
 scale together. */
display: inline-flex;
gap: 0.5em;
align-items: center;

svg {
  inline-size: 0.9em;
  block-size: 0.9em;
  fill: currentColor;
}

&:hover { background: color-mix(in oklab, var(--signal) 18%, transparent); }
    }

    .railed {
        dt, .term {
            font-family: var(--display);
            font-weight: 700;
            font-size: 0.9375rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--muted);
        }

        dd { max-inline-size: var(--measure); }
    }

    /* What answers where, and who may ask: the path, the permission, and
       why, in that order. Relative to the endpoint above it, so nothing
       here repeats the host. */
    /* A label inside a description, for the one distinction that matters
       in it: what a site must do, and what it may. */
    .railed dd .term {
        margin-block-start: 0.9rem;
        font-family: var(--display);
        font-weight: 700;
        font-size: 0.8125rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .railed dd .term:first-child { margin-block-start: 0; }

    /* An estate's worth of hostnames is a wall when it is one column
       per name. These are names, not sentences: they take as many
       columns as the box can hold, each track wide enough for the
       longest name here, and fall back to one column when it cannot
       hold two. No query — the track width decides. */
    .sites {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 29ch), 1fr));
        gap: 0.15rem 1.5rem;
        margin-block: 0.2rem;
        padding: 0;
        list-style: none;
        /* The mono face is also what makes `ch` above mean a hostname's
           character, and 29 of them covers a long third-level name
           (an exhibition subdomain under a two-label domain). A track
           that never has to wrap a name is the whole trick: two columns
           fit the narrower box, three the wide one, and neither breaks
           a hostname across lines. */
        font-family: var(--mono);
        font-size: 0.875rem;
    }

    /* The measure is for prose. This list wants the width it is in. */
    .railed dd:has(> .sites) { max-inline-size: none; }

    .paths {
        border-collapse: collapse;
        margin-block-start: 0.6rem;
        font-size: 0.9375rem;

        td, th {
            padding: 0.35rem 0.9rem 0.35rem 0;
            border-block-end: 1px solid var(--rule);
            text-align: start;
            vertical-align: baseline;
        }

        th {
            font-family: var(--display);
            font-weight: 700;
            font-size: 0.8125rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            white-space: nowrap;
            color: var(--muted);
        }

        td:first-child { white-space: nowrap; }

        /* On a phone the third column has nowhere left to go. Let the
           permission wrap onto two lines and tighten the gutters, which
           is enough to bring the whole table inside the screen; the
           path itself still never wraps, because a path broken across
           lines is a path somebody mistypes. .scroller stays underneath
           it as the last resort, for a narrower screen than this. */
        @container (inline-size < 24rem) {
            td, th { padding-inline-end: 0.4rem; }
            th { white-space: normal; }
        }
    }

    .listing {
        border-collapse: collapse;
        inline-size: 100%;
        font-size: 0.9375rem;

        th {
            font-family: var(--display);
            font-weight: 700;
            font-size: 0.8125rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted);
        }

        th, td {
            padding: 0.55rem 0.7rem 0.55rem 0;
            border-block-end: 1px solid var(--rule);
            text-align: start;
            vertical-align: baseline;
        }

        tbody tr:hover { background: var(--panel); }

        /* Inside .scroller, so refusing to wrap costs nothing. */
        td:first-child, .badge { white-space: nowrap; }
    }

    /* The state column, set from the row. Buttons rather than links
       because they post; shaped like the badge they replace, so the
       column still reads as a column of states rather than a strip of
       controls. The one that is disabled is the current state — it is
       the only one in full ink, which is what makes the column
       scannable. */
    .setting {
        form {
            display: flex;
            /* One line: the table is inside a .scroller, so a wide
               column costs a scroll rather than a taller row, and a
               row that grows makes the list harder to read down. */
            flex-wrap: nowrap;
            gap: 0.15rem;
        }

        button.badge {
            /* Comfortably past the 24px a pointer needs, without
               turning a table row into a toolbar. */
            min-block-size: 1.75rem;
            padding-inline: 0.35rem;
            border: 1px solid transparent;
            border-radius: 2px;
            background: none;
            cursor: pointer;

            &:hover, &:focus-visible {
                border-color: var(--rule);
                background: var(--panel);
                color: var(--ink);
            }

            &:disabled {
                cursor: default;
                color: var(--ink);

                &::before { border-color: var(--ink); }
            }
        }
    }

    /* The word carries the state; the mark only seconds it. */
    .badge {
        font-family: var(--display);
        font-size: 0.8125rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);

        &::before {
            content: "";
            display: inline-block;
            inline-size: 0.5em;
            block-size: 0.5em;
            margin-inline-end: 0.4em;
            border: 1px solid var(--muted);
            border-radius: 50%;
        }

        &.is-open { color: var(--ink); }
        &.is-open::before { background: var(--signal); border-color: var(--signal); }
        &.is-wontfix { font-style: italic; }

        /* Not a state, and it should not read as one: no dot, and set
           apart from the word that says what happened to the defect. */
        &.is-archived {
            margin-inline-start: 0.5rem;

            &::before { display: none; }
        }
    }

    /* One hue per channel, so a row of chips is scannable as a shape
       before it is read. The letter still carries the meaning: colour
       alone would fail anyone who cannot separate these six, and fails
       everyone under forced-colors. */
    .chip {
        --hue: 260;

        display: inline-block;
        min-inline-size: 1.35em;
        padding-inline: 0.2em;
        margin-inline-end: 0.15em;
        font-family: var(--display);
        font-size: 0.8125rem;
        letter-spacing: 0.04em;
        text-align: center;
        color: light-dark(oklch(25% 0.03 var(--hue)), oklch(95% 0.02 var(--hue)));
        background: light-dark(oklch(90% 0.055 var(--hue)),
                               oklch(34% 0.05 var(--hue)));
        border-radius: 2px;

        &[data-channel="fragment"]    { --hue: 250; }
        &[data-channel="rules"]       { --hue: 305; }
        &[data-channel="computed"]    { --hue: 195; }
        &[data-channel="diagnostics"] { --hue: 45;  }
        &[data-channel="audit"]       { --hue: 150; }
        &[data-channel="screenshot"]  { --hue: 355; }
    }

    .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.1rem;
        align-items: baseline;
        margin-block-start: var(--space);
        font-size: 0.875rem;
        color: var(--muted);

        dt, dd { margin: 0; }
    }

    .states {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;

        /* The three states are one form, archiving another, deleting a
           third. They sit in one row and the gap between groups says
           they are not three choices of the same kind. */
        form {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;

            & + form { margin-inline-start: 0.5rem; }
        }

        button, .button {
            min-block-size: 2.75rem;
            min-inline-size: 3.5rem;
            padding-inline: var(--space);
            font-family: var(--display);
            font-size: 0.9375rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--ink);
            background: var(--panel);
            border: 1px solid var(--rule);
            border-radius: 2px;
            cursor: pointer;

            &:hover { border-color: var(--ink); }
            &:disabled { color: var(--muted); cursor: default; }
        }

        /* Keeping a report is the safe answer and looks like a link;
           destroying it is a button, and says so in its colour. */
        .button {
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }

        .is-danger {
            color: var(--danger);
            border-color: currentcolor;

            &:hover { background: color-mix(in oklab, currentcolor 10%, transparent); }
        }
    }

    /* The page that asks before destroying something: what is about
       to go, then the two answers. Spaced apart because a button
       that sits against the last line of what it acts on gets
       pressed by someone who was still reading. */
    .confirm {
        display: grid;
        gap: 1.25rem;
        max-inline-size: var(--measure);
        margin-block-start: 1.25rem;
    }

    /* Between the working list and the archive. A line on its own: the
       table below is the page, and this only says which table it is. */
    .switch-list {
        margin-block: 0 var(--space);
        font-family: var(--display);
        font-size: 0.9375rem;
        letter-spacing: 0.04em;

        &:empty { display: none; }
    }

    pre, .fragment {
        padding: var(--space);
        background: var(--panel);
        border: 1px solid var(--rule);
        border-radius: 2px;
    }

    pre { overflow-x: auto; }

    /* Swagger UI arrives with a complete stylesheet of its own, and
       ours has no business inside it. Its version badges are a
       coloured <small> holding a bare <pre>, so the rule above filled
       them with near-white — under white text.

       `revert-layer` rather than a set of zeroes: it hands each of
       these back to the layer underneath, which is `vendor`, so the
       viewer looks the way its authors drew it rather than the way we
       would have guessed. Zeroing them took its code blocks with the
       badges. */
    .swagger-ui pre,
    .swagger-ui code,
    .swagger-ui kbd {
        padding: revert-layer;
        background: revert-layer;
        border: revert-layer;
        border-radius: revert-layer;
        font-family: revert-layer;
        font-size: revert-layer;
    }

    /* With the badges showing their own colours again, those colours
       turn out to fail: white on Swagger's green is 2.2:1 and white on
       its grey 3.8:1, measured, where small text wants 4.5. Same
       shapes, darker grounds.

       Written as constants rather than as our light-dark() tokens
       because the text on them is white in both schemes, so the ground
       has to be dark in both — a token that flips would fix one scheme
       by breaking the other. */
    .swagger-ui .info .title small {
        background: oklch(38% 0.02 265);
    }

    .swagger-ui .info .title small.version-stamp {
        background: oklch(38% 0.09 150);
    }

    .fragment {
        inline-size: 100%;
        min-block-size: 14rem;
    }

    .shot {
        max-inline-size: 100%;
        block-size: auto;
        border: 1px solid var(--rule);
    }

    kbd {
        padding-inline: 0.35em;
        border: 1px solid var(--rule);
        border-radius: 2px;

        /* One hue per relation, the same three the picker draws on the
           page and puts on its own help bar. A key that walks the tree
           is dressed as the box it will draw; a key that does not —
           Enter, Esc — keeps the plain border, which is the difference
           being shown. */
        &.k-parent, &.k-child, &.k-sibling {
            border-width: 2px;
            font-weight: 500;
        }

        &.k-parent {
            border-color: var(--parent);
            background: color-mix(in oklab, var(--parent) 20%, transparent);
        }

        &.k-child {
            border-color: var(--child);
            background: color-mix(in oklab, var(--child) 20%, transparent);
        }

        &.k-sibling {
            border-color: var(--sibling);
            background: color-mix(in oklab, var(--sibling) 20%, transparent);
        }
    }

    /* The bookmarklet's own source, in the open: it is four lines long,
       and a disclosure that hides four lines costs more than it saves.
       The button is beside it because that is what most people want
       from a block of code they cannot drag. */
    /* The thing you drag and the thing you copy are two ways to take the
       same object, so they stand side by side while there is room for
       two — the pill keeps its own width, the source gets the rest —
       and stack when there is not. Queried on the container, because
       what decides it is how wide this column is, not the window. */
    .take {
        display: grid;
        gap: var(--space);
        align-items: start;
        margin-block-start: 0.75rem;

        @container (inline-size > 44rem) {
            grid-template-columns: auto minmax(0, 1fr);
        }
    }

    .source {
        display: grid;
        gap: 0.4rem;
    }

    /* The button sits on the block it copies, in the corner, where it is
       out of the way of the text and unmistakably about it. The text is
       padded clear of it so a long first line cannot run underneath. */
    .source .block {
        position: relative;

        /* A grid item's automatic minimum is min-content, so a block
           holding an unbreakable path was as wide as that path and took
           the page with it. The bookmarklet never showed this: it
           breaks mid-token, so its min-content is a character. */
        min-inline-size: 0;
    }

    .bookmarklet-source,
    .prompt {
        inline-size: 100%;
        margin: 0;
        padding-inline-end: 5.5rem;
        white-space: pre-wrap;
        font-size: 0.8125rem;
    }

    /* The bookmarklet is one long unbreakable string, so it is allowed
       to break mid-token; the prompt is prose and is not. Both wrap
       rather than widen: a block that grows to its content takes the
       page with it, and this one is wider than a phone. */
    .bookmarklet-source { word-break: break-all; }

    .a-copy {
        position: absolute;
        inset-block-start: 0.4rem;
        inset-inline-end: 0.4rem;
        min-block-size: 1.75rem;
        padding-inline: 0.6rem;
        font-family: var(--display);
        font-size: 0.8125rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink);
        /* Opaque, not transparent: it is over text. */
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: 2px;
        cursor: pointer;

        &:hover { border-color: var(--ink); }
    }

    .empty {
        padding: 2rem 0;
        font-size: 1.125rem;
        color: var(--muted);
    }
}

@layer utilities {
    .visually-hidden {
        position: absolute;
        clip-path: inset(50%);
        inline-size: 1px;
        block-size: 1px;
        overflow: hidden;
    }

    /* Last layer, so it beats the measure each of these sets for itself
       — that is what the layer is for, and why no !important is needed. */
    .page.is-wide :is(p, dd, .lede, .cascade, .covers, .specimen) {
        max-inline-size: none;
    }
}

@media (prefers-reduced-motion: no-preference) {
    @layer components {
        .bookmarklet, .states button, .listing tbody tr { transition: 120ms ease-out; }
    }
}

@media (forced-colors: active) {
    @layer components {
        .cascade .is-selector { border-inline-start-color: Highlight; }
        .badge.is-open::before { background: Highlight; }
    }
}
</style>
</head>
<body>
<div class="page<%= " is-wide" if @wide %>">
    <header class="masthead">
        <p class="eyebrow">Corrigenda</p>
        <nav>
            <%# Named for the page, not for one thing on it: the
                bookmarklet shares it with the add-on, the four kinds of
                report, and how to point a site here. %>
            <a href="<%= mount("/") %>">Guide</a>
            <a href="<%= mount("/review/") %>">Reports</a>
            <%# Only where there is an interface to describe. A tab
                leading to a 404 is worse than no tab, and the endpoint
                itself answers 404 when the deployment has not asked
                for it. %>
            <% if api_offered? %>
                <a href="<%= mount("/apidocs") %>">API</a>
            <% end %>
        </nav>
    </header>

    <main>
        <%== yield %>
    </main>

    <footer class="colophon">
        <p>Corrigenda <%= Corrigenda::VERSION %></p>
        <p>The widget served from here is this version.</p>
    </footer>
</div>
</body>
</html>
