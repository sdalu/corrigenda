<h1>Delete this report?</h1>

<p class="caveat is-warning">
    There is no undo. The report, its screenshot and whatever else it
    carried are removed from disk, and the line that says it existed is
    taken out of the index.
</p>

<div class="confirm">
    <dl class="railed">
        <dt>Reported</dt>
        <dd><%= id %></dd>

        <dt>Page</dt>
        <dd><%= document.dig("page", "url") %></dd>

        <% unless document["message"].to_s.empty? %>
            <dt>Message</dt>
            <dd><%= document["message"] %></dd>
        <% end %>

        <dt>Files</dt>
        <dd><%= files.join(", ") %></dd>
    </dl>

    <%# Three answers, and the safe two are together: keeping it as it
        is, and keeping it out of the way. Archiving is offered here
        because wanting a report gone from the list is the usual reason
        for arriving on this page, and it is the answer that does not
        destroy anything. %>
    <div class="states">
        <form method="post" action="<%= to("/#{id}/delete", false) %>">
            <input type="hidden" name="confirm" value="yes">
            <button class="is-danger" name="delete" value="yes">Delete for good</button>
        </form>

        <a class="button" href="<%= to("/#{id}", false) %>">Keep it</a>

        <% unless archived %>
            <form method="post" action="<%= to("/#{id}/archive", false) %>">
                <input type="hidden" name="archived" value="1">
                <button>Archive instead</button>
            </form>
        <% end %>
    </div>
</div>
