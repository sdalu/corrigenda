<h1>Reports</h1>

<% if entries.empty? %>
    <p class="empty">
        Nothing reported yet. Take the
        <a href="<%= mount("/") %>">bookmarklet</a> to a page and pick
        something.
    </p>
<% else %>
    <div class="scroller">
        <table class="listing">
            <thead>
                <tr>
                    <th>When</th><th>Kind</th><th>Page</th>
                    <th>Summary</th><th>Sent</th><th>By</th><th>State</th>
                </tr>
            </thead>
            <tbody>
                <% entries.each do |entry| %>
                    <tr>
                        <td><a href="<%= to("/#{entry['id']}", false) %>"><%= entry["at"] %></a></td>
                        <td><%= entry["type"] %></td>
                        <td><%= entry["url"] %></td>
                        <td><%= summarise(entry) %></td>
                        <td><%== channels(entry["channels"]) %></td>
                        <td><%= entry["reporter"] %></td>
                        <td><span class="badge is-<%= entry["state"] %>"><%= entry["state"] %></span></td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>

    <dl class="legend">
        <% DebugFeedback::CHANNELS.each do |key, (mark, label)| %>
            <dt><span class="chip" data-channel="<%= key %>"><%= mark %></span></dt>
            <dd><%= label %></dd>
        <% end %>
    </dl>
<% end %>
