<h1><%= archived ? "Archived reports" : "Reports" %></h1>

<p class="switch-list">
    <% if archived %>
        <a href="<%= to("/", false) %>">← The working list<%=
            " (#{other})" if other.positive? %></a>
    <% elsif other.positive? %>
        <a href="<%= to("/?archived=1", false) %>">Archived (<%= other %>) →</a>
    <% end %>
</p>

<% if entries.empty? %>
    <p class="empty">
        <% if archived %>
            Nothing archived. A report is archived from its own page,
            which takes it out of the list without destroying it.
        <% else %>
            Nothing reported yet. Take the
            <a href="<%= mount("/") %>">bookmarklet</a> to a page and pick
            something.
        <% end %>
    </p>
<% else %>
    <div class="scroller">
        <table class="listing">
            <thead>
                <tr>
                    <th>When</th><th>Kind</th><th>Page</th>
                    <th>Summary</th><th>Sent</th><th>By</th><th>State</th>
                </tr>
            </thead>
            <tbody>
                <% entries.each do |entry| %>
                    <tr>
                        <td><a href="<%= to("/#{entry['id']}", false) %>"><%= entry["at"] %></a></td>
                        <td><%= entry["type"] %></td>
                        <td><%= entry["url"] %></td>
                        <td><%= summarise(entry) %></td>
                        <td><%== channels(entry["channels"]) %></td>
                        <td><%= entry["reporter"] %></td>
                        <%# The state is set from here as well as from
                            the report's own page: triaging a morning's
                            reports meant opening each one and coming
                            back, and the answer is usually obvious from
                            the summary. The current state is the
                            disabled button, so the row still says what
                            it is without a second control saying it.

                            `from=list` is what sends you back here
                            rather than into the report — the same
                            handler, told where the press came from. %>
                        <td class="setting">
                            <form method="post"
                                  action="<%= to("/#{entry['id']}/state", false) %>">
                                <input type="hidden" name="from" value="list">
                                <% if archived %>
                                    <input type="hidden" name="archived" value="1">
                                <% end %>
                                <% Corrigenda::Store::STATES.each do |value| %>
                                    <button name="state" value="<%= value %>"
                                            class="badge is-<%= value %>"
                                            <%= " disabled" if value == entry["state"] %>
                                            title="<%= value == entry["state"] ? "Already #{value}" : "Mark #{value}" %>"><%= value %></button>
                                <% end %>
                            </form>
                        </td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>

    <dl class="legend">
        <% Corrigenda::CHANNELS.each do |key, (mark, label)| %>
            <dt><span class="chip" data-channel="<%= key %>"><%= mark %></span></dt>
            <dd><%= label %></dd>
        <% end %>
    </dl>
<% end %>
