<h1><%= archived ? "Archived reports" : "Reports" %></h1>

<p class="switch-list">
    <% if archived %>
        <a href="<%= to("/", false) %>">← The working list<%=
            " (#{other})" if other.positive? %></a>
    <% elsif other.positive? %>
        <a href="<%= to("/?archived=1", false) %>">Archived (<%= other %>) →</a>
    <% end %>
</p>

<% if entries.empty? %>
    <p class="empty">
        <% if archived %>
            Nothing archived. A report is archived from its own page,
            which takes it out of the list without destroying it.
        <% else %>
            Nothing reported yet. Take the
            <a href="<%= mount("/") %>">bookmarklet</a> to a page and pick
            something.
        <% end %>
    </p>
<% else %>
    <div class="scroller">
        <table class="listing">
            <thead>
                <tr>
                    <th>When</th><th>Kind</th><th>Page</th>
                    <th>Summary</th><th>Sent</th><th>By</th><th>State</th>
                </tr>
            </thead>
            <tbody>
                <% entries.each do |entry| %>
                    <tr>
                        <%# To the minute, without the T and the Z: they
                            are punctuation for a machine, and the width
                            they cost is what the controls at the other
                            end of the row need. The whole stamp is in
                            the title, and in the report. %>
                        <td><a href="<%= to("/#{entry['id']}", false) %>"
                               title="<%= entry["at"] %>"><%=
                            entry["at"].to_s[0, 16].tr("T", " ") %></a></td>
                        <td><%= entry["type"] %></td>
                        <td><%= entry["url"] %></td>
                        <td><%= summarise(entry) %></td>
                        <td><%== channels(entry["channels"]) %></td>
                        <td><%= entry["reporter"] %></td>
                        <%# The state is set from here as well as from
                            the report's own page: triaging a morning's
                            reports meant opening each one and coming
                            back, and the answer is usually obvious from
                            the summary. The same switch as there, in
                            its small size — the filled one is the state
                            the report is in, so the column says what
                            each report is without a second control
                            beside it saying so.

                            `from` is what sends you back here rather
                            than into the report: the same handler, told
                            where the press came from. %>
                        <td class="setting">
                            <form class="switch is-compact" method="post"
                                  action="<%= to("/#{entry['id']}/state", false) %>">
                                <input type="hidden" name="from"
                                       value="<%= archived ? "archive" : "list" %>">
                                <% Corrigenda::Store::STATES.each do |value| %>
                                    <% now = value == entry["state"] %>
                                    <button name="state" value="<%= value %>"
                                            class="is-<%= value %>"
                                            <%= now ? %(aria-current="true" disabled) : "" %>
                                            title="<%= now ? "Already #{value}" : "Mark #{value}" %>"><%= value %></button>
                                <% end %>
                            </form>

                            <%# And filed from the row as well. The state
                                says what happened to the defect; this
                                says whether anyone still wants it in
                                front of them, which is the other half of
                                triage and was the half that still meant
                                opening the report. %>
                            <form class="filing" method="post"
                                  action="<%= to("/#{entry['id']}/archive", false) %>">
                                <input type="hidden" name="from"
                                       value="<%= archived ? "archive" : "list" %>">
                                <input type="hidden" name="archived"
                                       value="<%= archived ? "0" : "1" %>">
                                <button
                                        title="<%= archived ? "Back to the working list" : "Out of the list, keeping everything" %>"><%= archived ? "restore" : "archive" %></button>
                            </form>
                        </td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>

    <dl class="legend">
        <% Corrigenda::CHANNELS.each do |key, (mark, label)| %>
            <dt><span class="chip" data-channel="<%= key %>"><%= mark %></span></dt>
            <dd><%= label %></dd>
        <% end %>
    </dl>
<% end %>
